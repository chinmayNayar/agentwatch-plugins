{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT:-.}/scripts/aw.sh\" hook cursor sessionStart",
        "timeout": 5
      }
    ],
    "sessionEnd": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT:-.}/scripts/aw.sh\" hook cursor sessionEnd",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT:-.}/scripts/aw.sh\" hook cursor beforeSubmitPrompt",
        "timeout": 5
      }
    ],
    "preToolUse": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT:-.}/scripts/aw.sh\" hook cursor preToolUse",
        "timeout": 5
      }
    ],
    "beforeShellExecution": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT:-.}/scripts/aw.sh\" hook cursor beforeShellExecution",
        "timeout": 5
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT:-.}/scripts/aw.sh\" hook cursor beforeMCPExecution",
        "timeout": 5
      }
    ],
    "beforeReadFile": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT:-.}/scripts/aw.sh\" hook cursor beforeReadFile",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT:-.}/scripts/aw.sh\" hook cursor postToolUse",
        "timeout": 5
      }
    ],
    "postToolUseFailure": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT:-.}/scripts/aw.sh\" hook cursor postToolUseFailure",
        "timeout": 5
      }
