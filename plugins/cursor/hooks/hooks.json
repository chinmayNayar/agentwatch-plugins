    "afterAgentResponse": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT:-.}/scripts/aw.sh\" hook cursor afterAgentResponse",
        "timeout": 5
      }
    ],
    "subagentStart": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT:-.}/scripts/aw.sh\" hook cursor subagentStart",
        "timeout": 5
      }
    ],
    "subagentStop": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT:-.}/scripts/aw.sh\" hook cursor subagentStop",
        "timeout": 5
      }
    ],
    "preCompact": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT:-.}/scripts/aw.sh\" hook cursor preCompact",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "\"${CURSOR_PLUGIN_ROOT:-.}/scripts/aw.sh\" hook cursor stop",
        "timeout": 5
      }
    ]
  }
}
